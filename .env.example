# Base URL of the Flot Boutique backend API (no trailing slash).
# - iOS simulator:      https://127.0.0.1:8000/api  (the dev cert must be trusted by the simulator)
# - Android emulator:   https://10.0.2.2:8000/api   (10.0.2.2 is the host machine)
# - Physical device:    https://<your-LAN-IP>:8000/api
EXPO_PUBLIC_API_URL=https://127.0.0.1:8000/api
